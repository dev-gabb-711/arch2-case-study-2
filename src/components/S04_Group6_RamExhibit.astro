---
import "../styles/S04_Group6_ram.css";

import WhatIsRam from "./S04_Group6_WhatIsRam.jsx";
import RamJourney from "./S04_Group6_RamJourney.jsx";
import EvolutionLogic from "./S04_Group6_Evolution.jsx";
import MemComEvolution from "./S04_Group6_MemoryCommunication.jsx";
import QuizLogic from "./S04_Group6_ChallengeQuiz.jsx";

import switchPokemon from "../assets/S04_Group6_switch-pokemon.png";
import nintendoSwitch from "../assets/S04_Group6_ir-nintendo.png";
---

<section class="ram-stage">
  <div class="ram-page">

    <!-- =====================================================
         SECTION 0 — TITLE SECTION
         ===================================================== -->

    <header
      id="ram-exhibit-title"
      class="ram-hero"
    >

      <!-- Decorative HUD layer -->
      <div
        class="hero-hud"
        aria-hidden="true"
      >
        <div class="hero-grid"></div>
        <div class="hero-circle-glow"></div>
        <div class="hero-frame"></div>
        <div class="hero-scan-line"></div>
      </div>

      <!-- System status -->
      <div
        class="hero-system-status"
        aria-hidden="true"
      >
        <span class="hero-status-dots"></span>

        <span class="hero-status-text">
          SYSTEM ONLINE
        </span>

        <span class="hero-status-dots"></span>
      </div>

      <!-- Main title -->
      <div class="hero-title-block">
        <h1 class="glow-title">
          INSIDE RAM
        </h1>

        <p>
          COMPUTER MEMORY IN MOTION
        </p>
      </div>

      <!-- Left information panel -->
      <aside
        class="hero-fact-panel"
        aria-label="RAM fact"
      >
        <div class="hero-panel-heading">
          <span
            class="hero-panel-marker"
            aria-hidden="true"
          ></span>

          <span class="hero-panel-kicker">
            DID YOU KNOW?
          </span>
        </div>

        <p>
          The earliest form of computer memory used a large rotating
          magnetic drum. Over time, memory became smaller, faster,
          and powerful enough to support modern handheld systems
          such as the Nintendo Switch.
        </p>

        <div
          class="hero-fact-status"
          aria-hidden="true"
        >
          <span>MEMORY ARCHIVE</span>
          <span>READY</span>
        </div>
      </aside>

      <!-- Center illustration -->
      <div class="hero-visual">

        <div
          class="hero-reticle"
          aria-hidden="true"
        ></div>

        <div
          class="hero-target-frame"
          aria-hidden="true"
        ></div>

        <div
          class="hero-target-crosshair"
          aria-hidden="true"
        ></div>

        <img
          class="hero-switch"
          src={switchPokemon.src}
          alt="Nintendo Switch showing a game scene"
        />

        <div class="hero-device-readout">
          <span
            class="hero-device-dot"
            aria-hidden="true"
          ></span>

          <span class="hero-device-label">
            NINTENDO SWITCH
          </span>

          <span class="hero-device-code">
            ACTIVE MEMORY SYSTEM
          </span>
        </div>
      </div>

      <!-- Right navigation panel -->
      <nav
        class="hero-directory"
        aria-label="Exhibit Navigation"
      >
        <div class="hero-directory-heading">
          <span
            class="hero-directory-marker"
            aria-hidden="true"
          ></span>

          <span>
            DISCUSSION DIRECTORY
          </span>
        </div>

        <a href="#what-is-ram">
          <span
            class="hero-nav-icon"
            aria-hidden="true"
          >
            ▣
          </span>

          <span class="hero-nav-copy">
            <small>SECTION 01</small>
            <strong>What is RAM?</strong>
          </span>

          <span
            class="hero-nav-arrow"
            aria-hidden="true"
          >
            ›
          </span>
        </a>

        <a href="#the-evolution-of-ram">
          <span
            class="hero-nav-icon"
            aria-hidden="true"
          >
            ⌁
          </span>

          <span class="hero-nav-copy">
            <small>SECTION 02</small>
            <strong>The Evolution of RAM</strong>
          </span>

          <span
            class="hero-nav-arrow"
            aria-hidden="true"
          >
            ›
          </span>
        </a>

        <a href="#inside-the-ram-the-internal-data-journey">
          <span
            class="hero-nav-icon"
            aria-hidden="true"
          >
            ◇
          </span>

          <span class="hero-nav-copy">
            <small>SECTION 03</small>
            <strong>Inside RAM</strong>
          </span>

          <span
            class="hero-nav-arrow"
            aria-hidden="true"
          >
            ›
          </span>
        </a>

        <a href="#memory-access-and-communication">
          <span
            class="hero-nav-icon"
            aria-hidden="true"
          >
            ⌾
          </span>

          <span class="hero-nav-copy">
            <small>SECTION 04</small>
            <strong>Memory Access and Communication</strong>
          </span>

          <span
            class="hero-nav-arrow"
            aria-hidden="true"
          >
            ›
          </span>
        </a>

        <a href="#challenge-quiz">
          <span
            class="hero-nav-icon"
            aria-hidden="true"
          >
            ◆
          </span>

          <span class="hero-nav-copy">
            <small>SECTION 05</small>
            <strong>Challenge Quiz</strong>
          </span>

          <span
            class="hero-nav-arrow"
            aria-hidden="true"
          >
            ›
          </span>
        </a>
      </nav>

      <!-- Bottom HUD -->
      <div
        class="hero-bottom-hud"
        aria-hidden="true"
      >
        <div class="hero-bottom-line hero-bottom-line-left"></div>

        <div class="hero-bottom-center-mark">
          <span></span>
          <span></span>
          <span></span>
        </div>

        <div class="hero-bottom-line hero-bottom-line-right"></div>
      </div>

      <!-- Scroll indicator -->
      <a
        class="hero-scroll-cue"
        href="#what-is-ram"
        aria-label="Scroll to Section 1"
      >
        <span class="hero-scroll-label">
          BEGIN EXHIBIT
        </span>

        <span
          class="hero-scroll-chevron"
          aria-hidden="true"
        ></span>

        <span
          class="hero-scroll-chevron"
          aria-hidden="true"
        ></span>
      </a>

    </header>

    <!-- =====================================================
         SECTION 1 — UNDERSTANDING RAM
         ===================================================== -->

    <div
      id="ram-exhibit-what-is-ram"
      class="ram-section-anchor"
    >
      <WhatIsRam client:load />
    </div>

    <!-- =====================================================
         SECTION 2 — EVOLUTION OF RAM
         ===================================================== -->

    <div
      id="ram-exhibit-evolution"
      class="ram-section-anchor"
    >
      <EvolutionLogic client:load />
    </div>

    <!-- =====================================================
         SECTION 3 — INTERNAL DATA JOURNEY
         ===================================================== -->

    <div
      id="ram-exhibit-internal-journey"
      class="ram-section-anchor"
    >
      <section
        class="big-section"
      >
        <h2 class="journey-title">
          INSIDE THE RAM
        </h2>

        <p class="journey-subtitle">
          THE INTERNAL DATA JOURNEY
        </p>

        <div
          id="switch-container"
          class="switch-container"
        >
          <div class="nintendo-wrapper">
            <img
              class="nintendo-image"
              src={nintendoSwitch.src}
              alt="Nintendo Switch"
            />
          </div>

          <div class="switch-screen-content">
            <RamJourney client:load />
          </div>
        </div>
      </section>
    </div>

    <!-- =====================================================
         SECTION 4 — MEMORY ACCESS
         ===================================================== -->

    <div
      id="ram-exhibit-memory-access"
      class="ram-section-anchor"
    >
      <section
        id="memory-access-and-communication"
        class="big-section"
      >
        <div class="memory-header">
          <h2 class="glow-title">
            MEMORY ACCESS SIMULATOR
          </h2>

          <p class="memory-subtitle">
            CPU TO RAM COMMUNICATION
          </p>
        </div>

        <div class="memory-middle">

          <div class="memory-grid-area">

            <div class="memory-grid-header">
              <span></span>

              {
                Array.from({ length: 12 }).map((_, col) => (
                  <span>C{col}</span>
                ))
              }
            </div>

            <div class="memory-grid">
              {
                Array.from({ length: 5 }).map((_, row) => (
                  <>
                    <span class="row-label">
                      R{row}
                    </span>

                    {
                      Array.from({ length: 12 }).map((_, col) => (
                        <div
                          class={`memory-cell
                            ${row === 2 ? "active-row" : ""}
                            ${col === 4 ? "active-column" : ""}
                            ${
                              row === 2 && col === 4
                                ? "selected-cell"
                                : ""
                            }`}
                        >
                        </div>
                      ))
                    }
                  </>
                ))
              }
            </div>

            <div class="memory-step">
              Click any cell to see how RAS (row) and CAS (column)
              addresses split to target data in the matrix.
            </div>

          </div>

          <div class="memory-output">

            <div class="memory-card cpu-request">
              <h3>
                CPU REQUEST
              </h3>

              <div class="request-item">
                <span>Operation</span>
                <strong>READ</strong>
              </div>

              <div class="request-item">
                <span>Address</span>
                <strong>[UNINITIALIZED]</strong>
              </div>

              <div class="request-item">
                <span>Data</span>
                <strong>[UNIDENTIFIED]</strong>
              </div>
            </div>

            <div class="memory-card">
              <h3>
                CURRENT SELECTION
              </h3>

              <p>
                <strong>Row:</strong> R
                <strong> Col:</strong> C
              </p>

              <p>
                <strong>Payload:</strong> [DATA]
              </p>
            </div>

          </div>

        </div>

        <div class="memory-info">

          <div class="memory-card">

            <h3>
              HOW MEMORY ACCESS WORKS
            </h3>

            <p>
              DRAM stores data in a grid of rows and columns. To access a
              memory location, the controller first selects the row using
              <strong> RAS</strong>, then the column using
              <strong> CAS</strong>. This two-step process reduces hardware
              complexity while allowing fast access to the requested data.
            </p>

            <div class="info-split">

              <div class="info-split-item">
                <h4>
                  RAS (Row Access Strobe)
                </h4>

                <p>
                  RAS activates the row containing the requested data. Once the
                  row is open, it remains ready for the column to be selected.
                </p>

                <p>
                  <strong>Purpose:</strong>
                  Opens the correct memory row for access.
                </p>
              </div>

              <div class="info-split-item">
                <h4>
                  CAS (Column Access Strobe)
                </h4>

                <p>
                  CAS selects the correct column within the active row and
                  retrieves the data stored at their intersection.
                </p>

                <p>
                  <strong>Purpose:</strong>
                  Selects the exact memory cell within the active row.
                </p>
              </div>

            </div>

          </div>

        </div>

        <MemComEvolution client:load />
      </section>
    </div>

    <!-- =====================================================
        SECTION 5 — CHALLENGE QUIZ
        ===================================================== -->

    <div
      id="ram-exhibit-challenge-quiz"
      class="ram-section-anchor"
    >
      <section
        id="challenge-quiz"
        class="quiz-section"
      >
        <!-- Decorative HUD background -->
        <div
          class="quiz-hud-background"
          aria-hidden="true"
        >
          <div class="quiz-grid"></div>
          <div class="quiz-background-glow"></div>
          <div class="quiz-outer-frame"></div>
        </div>

        <!-- Section header -->
        <header class="quiz-header">
          <div class="quiz-section-marker">
            <span class="quiz-marker-dots"></span>

            <span>
              SECTION 05
            </span>

            <span class="quiz-marker-dots"></span>
          </div>

          <h2>
            CHALLENGE QUIZ
          </h2>

          <p class="quiz-header-subtitle">
            TEST YOUR KNOWLEDGE
          </p>

          <div class="quiz-introduction">
            <p class="quiz-introduction-hook">
              A computer is only as reliable as the information it can
              retrieve—and so is your memory.
            </p>

            <p class="quiz-instructions">
              Complete all ten questions by selecting one answer per item.
              Each response will be checked immediately, and your final
              retention score will be revealed after the last question.
            </p>
          </div>
        </header>

        <!-- React controls the questions, answers, progress, and score -->
        <QuizLogic client:load />
      </section>
    </div>
</section>

<script is:inline>
  const ramSectionMap = {
    "#title":
      "#ram-exhibit-title",

    "#what-is-ram":
      "#ram-exhibit-what-is-ram",

    "#the-evolution-of-ram":
      "#ram-exhibit-evolution",

    "#inside-the-ram-the-internal-data-journey":
      "#ram-exhibit-internal-journey",

    "#inside-the-ram---the-internal-data-journey":
      "#ram-exhibit-internal-journey",

    "#memory-access-and-communication":
      "#ram-exhibit-memory-access",

    "#challenge-quiz":
      "#ram-exhibit-challenge-quiz"
  };

  function scrollToRamSection(hash, behavior = "smooth") {
    const targetSelector = ramSectionMap[hash];

    if (!targetSelector) {
      return false;
    }

    const target = document.querySelector(targetSelector);

    if (!target) {
      return false;
    }

    target.scrollIntoView({
      behavior,
      block: "start"
    });

    history.replaceState(
      null,
      "",
      `${window.location.pathname}${window.location.search}${hash}`
    );

    return true;
  }

  document.addEventListener("click", (event) => {
    const clickedElement = event.target;

    if (!(clickedElement instanceof Element)) {
      return;
    }

    const link = clickedElement.closest('a[href^="#"]');

    if (!link) {
      return;
    }

    const hash = link.getAttribute("href");

    if (!hash || !ramSectionMap[hash]) {
      return;
    }

    event.preventDefault();

    scrollToRamSection(hash);
  });

  window.addEventListener("load", () => {
    const currentHash = window.location.hash;

    if (!ramSectionMap[currentHash]) {
      return;
    }

    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        scrollToRamSection(currentHash, "auto");
      });
    });
  });
</script>