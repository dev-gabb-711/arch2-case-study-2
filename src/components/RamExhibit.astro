---
import "../styles/ram.css";

import switchPokemon from "../assets/switch-pokemon.png";
import gameboy from "../assets/gameboy.png";

import arrowsGraphic from "../assets/arrows.png";
import pointLineGraphic from "../assets/point_line.png";
import titleLineGraphic from "../assets/title_line.png";
import topCornerGraphic from "../assets/top_corner.png";
import pointerGraphic from "../assets/pointer.png";
---

<section class="ram-stage">
  <div class="ram-page">

    <header id="title" class="ram-hero">
      <div class="hero-circle-glow"></div>

      <img class="hud-graphic hud-top-corner" src={topCornerGraphic.src} alt="" aria-hidden="true" />
      <img class="hud-graphic hud-title-line" src={titleLineGraphic.src} alt="" aria-hidden="true" />
      <img class="hud-graphic hud-point-line" src={pointLineGraphic.src} alt="" aria-hidden="true" />

      <div class="discussion-label">
        <span class="label-title">DISCUSSION POINTS</span>
      </div>

      <img class="hud-graphic hud-arrows" src={arrowsGraphic.src} alt="" aria-hidden="true" />

      <div class="hook-text">
        OUR HOOK SENTENCE WILL BE HERE. TO GRAB AUDIENCE ATTENTION TO OUR TOPIC.
      </div>

      <div class="discussion-points">
        <a href="#what-is-ram">What is RAM?</a>
        <a href="#the-evolution-of-ram">The Evolution of RAM</a>
        <a href="#inside-the-ram-the-internal-data-journey">Inside RAM</a>
        <a href="#memory-access-and-communication">Memory Access and Communication</a>
      </div>

      <img class="hero-switch" src={switchPokemon.src} alt="Game memory visual" />

      <div class="facts-text">
        SOME OTHER INTERESTING FACTS ABOUT RAM.
      </div>

      <div class="hero-title-block">
        <h1 class="glow-title">INSIDE RAM</h1>
        <p>COMPUTER MEMORY IN MOTION</p>
      </div>
    </header>

    <section id="what-is-ram" class="what-section">
      <div class="what-left">
        <h3>TITLE OF SUB-TOPIC 1</h3>
        <p>
          This section is designed to provide a dynamic and interactive experience.
          As users scroll, the graphic on the left may animate through effects such
          as tilting, scaling, rotating, or changing to match the displayed content.
          Information will be revealed progressively to improve readability and
          maintain engagement.
        </p>
      </div>

      <img class="gameboy-image" src={gameboy.src} alt="Game Boy memory visual" />

      <div class="what-right">
        <h2 class="glow-title">WHAT IS RAM?</h2>
        <p>COMPUTER MEMORY IN MOTION</p>

        <div class="what-callout">
          Some point of interest that summarizes the whole explanation.
        </div>

        <img class="pointer" src={pointerGraphic.src} alt="" aria-hidden="true" />
      </div>
    </section>

    <section id="the-evolution-of-ram" class="big-section">
      <h2 class="glow-title">THE EVOLUTION OF RAM</h2>
      <p>COMPUTER MEMORY THROUGH TIME</p>
    </section>

    <section id="inside-the-ram-the-internal-data-journey" class="big-section">
      <h2 class="glow-title">INSIDE THE RAM</h2>
      <p>THE INTERNAL DATA JOURNEY</p>
    </section>

    <section id="memory-access-and-communication" class="big-section">
      <h2 class="glow-title">MEMORY ACCESS SIMULATOR</h2>
      <p>CPU TO RAM COMMUNICATION</p>
    </section>

    <section id="challenge-quiz" class="big-section">
      <h2 class="glow-title">CHALLENGE QUIZ</h2>
      <p>TEST YOUR KNOWLEDGE</p>
    </section>

  </div>
</section>